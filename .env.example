# Integração opcional; pendência contratual para publicação: docs/LEGAL_REVIEW.md.
# Não ative faturação para contornar a exigência de utilização sem custos.
# Copie este ficheiro para .env, nesta pasta (junto de package.json).
# Cole a sua chave depois de =, apenas no ficheiro .env.
# Preferível: use Configurar Gemini opcional no emulador. O diálogo guarda
# as definições no .env nesta pasta, junto de package.json (ignorado pelo Git).
GEMINI_API_KEY=

# Confirme no Google AI Studio que o projeto da chave está Free,
# SEM faturação ativada. Só depois escreva confirmed depois de =.
# Isto declara a sua verificação; não verifica nem altera a faturação Google.
QL_GEMINI_FREE_ONLY=
