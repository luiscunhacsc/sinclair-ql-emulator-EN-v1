# Optional integration; outstanding publication terms: docs/LEGAL_REVIEW.md.
# Do not enable billing to work around the requirement for use without charges.
# Copy this file to .env in this folder (alongside package.json).
# Paste your key after =, only in the .env file.
# Recommended: use Set up optional Gemini in the emulator. The dialogue saves
# settings to .env alongside package.json (ignored by Git).
GEMINI_API_KEY=

# Check in Google AI Studio that the key's project is Free,
# with billing DISABLED. Only then enter confirmed after =.
# This declares your check; it does not verify or change Google billing.
QL_GEMINI_FREE_ONLY=
